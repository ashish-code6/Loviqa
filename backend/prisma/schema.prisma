generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "cts"
  importFileExtension   = "cjs"
}


datasource db {
  provider = "postgresql"
}


model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       UserProfile?
  interests     UserInterest[]

  sentMatchScores     MatchScore[] @relation("UserMatchScores")
  receivedMatchScores MatchScore[] @relation("CandidateMatchScores")
  dailyEmojis         DailyEmoji[]
}


// Defines a one-to-one relationship between UserProfile and User.
model UserProfile {
  id       String  @id @default(uuid())
  userId   String  @unique

  age      Int?
  gender   String?
  bio      String?
  location String?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}


// Predefined/master interests.
model Interest {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())

  userInterests UserInterest[]
}


// Connects User and Interest.
model UserInterest {
  id             String @id @default(uuid())
  userId         String
  interestId     String

  customInterest String?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  interest Interest @relation(fields: [interestId],references: [id],onDelete: Cascade)

  @@unique([userId, interestId])
}


// Stores compatibility scores between two users.
model MatchScore {
  id String @id @default(uuid())

  userId      String
  candidateId String

  interestScore Int
  aiScore       Int
  finalScore    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserMatchScores", fields: [userId],references: [id],onDelete: Cascade)

  candidate User @relation("CandidateMatchScores",fields: [candidateId],references: [id],onDelete: Cascade)

  @@unique([userId, candidateId])
  @@index([userId, finalScore])
}

model DailyEmoji {
  id        String   @id @default(uuid())
  userId    String
  emoji     String
  date      String

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@unique([userId, date])
}